@@ -781,6 +782,9 @@
     wire [11:0] lsx = {3'd0, texx} + us_s[11:0];
     wire [12:0] lsy = texy + {2'd0, lev_off} + vs_s[12:0];
     wire [10:0] lnxp = snx[10:0] + 11'd1;     // LRMM counts pixels
+`ifndef V9968_UPSTREAM
+    wire        use_hmmv = fill_hmmv && (lop == 4'd0);
