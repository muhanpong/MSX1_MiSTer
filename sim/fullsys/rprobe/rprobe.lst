33    0040                      macro SENTTEST
34    0040 ~                    ld de,0
35    0040 ~                    ld a,5
35    0040 ~              out (0FEh),a
35    0040 ~              out (0FFh),a     ; pages 2 and 3: segment 5
36    0040 ~                    ld a,5Ah
