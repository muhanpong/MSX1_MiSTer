# file opened: rprobe.asm
 1    0000              ; RPROBE for fullsys (tb_msx.sv -DRPROBE): replaces the BIOS at 0000h (GT pack).
 2    0000              ; Checks the memory paths core_builder's strobe review flagged, under a bench-side
 3    0000              ; delay injection (tb_msx.sv INJ_*).  Phases (OUT (2Eh),n), each followed by its
 4    0000              ; error count on port 2Fh (low, high):
 5    0000              ;   1  Z80   mapper RAM: 32 segments x 256 bytes written with LD (HL),A, read back
 6    0000              ;   2  Z80   FFFFh: 256 x (write subslot reg, read it, read 8000h), then the byte
 7    0000              ;            planted at BFFFh (= FFFFh of the page-3 segment) must have survived
 8    0000              ;            -- errors: low byte = wrong 8000h reads, high byte = sentinel lost
 9    0000              ;   3  R800  as 1        4  R800  as 2        0Fh done
10    0000              ; No stack: page 3 is a test segment.  turbor.sv overlays 002Dh and 0180h-018Bh.
11    0000                      org 0
12    0000 18 3E                jr start
13    0002 00 00 00...          ds 40h - $, 0
14    0040
15    0040                      macro RAMTEST
16    0040 ~                    ld de,0
17    0040 ~                    ld c,0
18    0040 ~            .ws:    ld a,c
18    0040 ~              out (0FEh),a
19    0040 ~                    ld hl,8000h
20    0040 ~            .wl:    ld a,l
20    0040 ~              xor h
20    0040 ~              xor c
20    0040 ~              ld (hl),a
21    0040 ~                    inc l
21    0040 ~              jr nz,.wl
22    0040 ~                    inc c
22    0040 ~              ld a,c
22    0040 ~              cp 32
22    0040 ~              jr nz,.ws
23    0040 ~                    ld c,0
24    0040 ~            .rs:    ld a,c
24    0040 ~              out (0FEh),a
25    0040 ~                    ld hl,8000h
26    0040 ~            .rl:    ld a,l
26    0040 ~              xor h
26    0040 ~              xor c
26    0040 ~              cp (hl)
26    0040 ~              jr z,.ok
27    0040 ~                    inc de
28    0040 ~            .ok:    inc l
28    0040 ~              jr nz,.rl
29    0040 ~                    inc c
29    0040 ~              ld a,c
29    0040 ~              cp 32
29    0040 ~              jr nz,.rs
30    0040 ~                    ld a,e
30    0040 ~              out (2Fh),a
30    0040 ~              ld a,d
30    0040 ~              out (2Fh),a
31    0040                      endm
32    0040
33    0040                      macro SENTTEST
34    0040 ~                    ld de,0
35    0040 ~                    ld a,5
35    0040 ~              out (0FEh),a
35    0040 ~              out (0FFh),a     ; pages 2 and 3: segment 5
36    0040 ~                    ld a,5Ah
36    0040 ~              ld (0BFFFh),a                 ; = FFFFh of the page-3 segment
37    0040 ~                    ld b,0
38    0040 ~            .l:     xor a
38    0040 ~              ld (0FFFFh),a                    ; subslot reg, value 00 (all subslots 0)
39    0040 ~                    ; (0Fh here crashed into RST 38h only while the PPI was never set up: every
40    0040 ~                    ;  page was slot 0, so FFFFh was slot 0's subslot register and page 0 left the
41    0040 ~                    ;  probe.  With the 82h mode word 0Fh passes -- docs/evidence_20261018)
42    0040 ~                    ld a,(0FFFFh)
43    0040 ~                    ld a,(8000h)
43    0040 ~              cp 85h
43    0040 ~              jr z,.k          ; RAMTEST left 80h^00h^05h there
44    0040 ~                    inc e
45    0040 ~            .k:     djnz .l
46    0040 ~                    ld a,(0BFFFh)
46    0040 ~              cp 5Ah
46    0040 ~              jr z,.s
47    0040 ~                    inc d
48    0040 ~            .s:     xor a
48    0040 ~              ld (0FFFFh),a
49    0040 ~                    ld a,e
49    0040 ~              out (2Fh),a
49    0040 ~              ld a,d
49    0040 ~              out (2Fh),a
50    0040                      endm
