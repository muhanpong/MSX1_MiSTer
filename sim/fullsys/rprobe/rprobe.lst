37    0040 ~                    ld b,0
38    0040 ~            .l:     ld a,b
38    0040 ~              and 0Fh
38    0040 ~              ld (0FFFFh),a         ; subslot reg; pages 2/3 stay subslot 0
39    0040 ~                    ld a,(0FFFFh)
40    0040 ~                    ld a,(8000h)
40    0040 ~              cp 85h
40    0040 ~              jr z,.k          ; RAMTEST left 80h^00h^05h there
41    0040 ~                    inc e
42    0040 ~            .k:     djnz .l
43    0040 ~                    ld a,(0BFFFh)
43    0040 ~              cp 5Ah
43    0040 ~              jr z,.s
44    0040 ~                    inc d
45    0040 ~            .s:     xor a
45    0040 ~              ld (0FFFFh),a
46    0040 ~                    ld a,e
46    0040 ~              out (2Fh),a
46    0040 ~              ld a,d
46    0040 ~              out (2Fh),a
47    0040                      endm
