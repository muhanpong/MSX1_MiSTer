200   0335 7A          >  ld a,d
200   0336 D3 2F       >  out (2Fh),a
201   0338
202   0338                      ; 7  ASO 224's first in-game wait: display OFF and IE0 off (R#1 = 02h), R#9 = 00h,
203   0338                      ;    R#19 = 68h, R#0 = 16h (SCREEN 5, IE1 on), then EI and NO polling -- the line
204   0338                      ;    interrupt must arrive as an IM 1 interrupt (0038h).  The handler does what the
205   0338                      ;    game's does: R#15 = 1, read S#1 (FH must be 1), R#15 = 0.
206   0338                      ;    Errors: no interrupt (timeout), or FH = 0 in the handler.
207   0338 3E 07                ld a,7
207   033A D3 2E          out (2Eh),a
208   033C 11 00 00             ld de,0
209   033F                      VREG 1, 02h
209   033F 3E 02       >        ld a,02h
209   0341 D3 99       >  out (99h),a
209   0343 3E 81       >  ld a,80h | 1
209   0345 D3 99       >  out (99h),a
210   0347                      VREG 9, 00h
210   0347 3E 00       >        ld a,00h
210   0349 D3 99       >  out (99h),a
210   034B 3E 89       >  ld a,80h | 9
210   034D D3 99       >  out (99h),a
211   034F                      VREG 19, 68h
211   034F 3E 68       >        ld a,68h
211   0351 D3 99       >  out (99h),a
211   0353 3E 93       >  ld a,80h | 19
211   0355 D3 99       >  out (99h),a
212   0357                  IFDEF P7NEG
213   0357 ~                    VREG 0, 06h                     ; negative control: IE1 off -> phase 7 must time out
214   0357                  ELSE
215   0357                      VREG 0, 16h
215   0357 3E 16       >        ld a,16h
215   0359 D3 99       >  out (99h),a
215   035B 3E 80       >  ld a,80h | 0
215   035D D3 99       >  out (99h),a
216   035F                  ENDIF
217   035F 0E 07                ld c,7
218   0361 ED 56                im 1
218   0363 FB             ei
219   0364 21 00 00             ld hl,0
220   0367 2B           i7w:    dec hl
220   0368 7C             ld a,h
220   0369 B5             or l
220   036A 20 FB          jr nz,i7w
221   036C F3                   di
222   036D 13                   inc de                          ; no line interrupt in ~65536 loops
223   036E 18 17                jr i7done
224   0370              v7:     VREG 15, 1
224   0370 3E 01       >        ld a,1
224   0372 D3 99       >  out (99h),a
224   0374 3E 8F       >  ld a,80h | 15
224   0376 D3 99       >  out (99h),a
225   0378 DB 99                in a,(99h)
225   037A E6 01          and 1
225   037C 20 01          jr nz,v7ok
226   037E 13                   inc de                          ; the handler saw FH = 0
227   037F              v7ok:   VREG 15, 0
227   037F 3E 00       >        ld a,0
227   0381 D3 99       >  out (99h),a
227   0383 3E 8F       >  ld a,80h | 15
227   0385 D3 99       >  out (99h),a
228   0387              i7done: VREG 0, 06h
