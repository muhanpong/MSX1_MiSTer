184   02D9 3C             inc a
184   02DA D3 9F          out (9Fh),a           ; EDATA 0,1
185   02DC 3E 48                ld a,48h
185   02DE D3 9D          out (9Dh),a
185   02E0 3E 01          ld a,1
185   02E2 D3 9F          out (9Fh),a      ; CTRL: RUN, wireframe
186   02E4 21 00 00             ld hl,0
