# file opened: vprobe.asm
  1   0000              ; VPROBE for fullsys (tb_msx.sv -DVPROBE, MSX_V9968 build): replaces the BIOS at 0000h.
  2   0000              ; Drives the V9968 (reset mode = V9958) through ports 98h-9Bh from the stock Z80 and
  3   0000              ; checks what comes back.  Phases (OUT (2Eh),n), each followed by its error count on
  4   0000              ; port 2Fh (low, high), the RPROBE protocol:
  5   0000              ;   1  VRAM through port 98h: 1 KB at 00000h, 1 KB at 1C000h (R#14 = 7), written
  6   0000              ;      with OUT (98h),A and read back with IN A,(98h); then 00000h again (aliasing)
  7   0000              ;   2  SCREEN 5, display on, HMMV fill 256 x 4 dots with 5Ah; poll S#2 CE until
  8   0000              ;      done (error = timeout), read the 512 bytes back through port 98h
  9   0000              ;   3  two VBLANKs (S#0 F set) with the display on -- the V9968 fetching VRAM
 10   0000              ;      through the V slot while the bench checks every read (error = timeout)
 11   0000              ;   4  IM 1 interrupt: R#1 IE0 on, EI, wait for the jump to 0038h (error = timeout)
 12   0000              ;   0Fh done
 13   0000              ; No stack and no RAM.  The code starts at 0040h and skips 0180h-018Bh (turbor.sv).
 14   0000                      org 0
 15   0000 18 3E                jr start
 16   0002 00 00 00...          ds 38h - $, 0
 17   0038 C3 DA 01             jp vint                         ; IM 1 (phase 4).  No RAM: the pushed PC is lost
 18   003B 00 00 00...          ds 40h - $, 0
 19   0040
 20   0040                      macro VREG reg, val
 21   0040 ~                    ld a,val
 21   0040 ~              out (99h),a
 21   0040 ~              ld a,80h | reg
 21   0040 ~              out (99h),a
 22   0040                      endm
 23   0040                      ; VRAM address: R#14 = bank, then A7..0, A13..8 (| 40h for write)
 24   0040                      macro VADDR bank, a13, wr
 25   0040 ~                    VREG 14, bank
 26   0040 ~                    xor a
 26   0040 ~              out (99h),a
 26   0040 ~              ld a,a13 | (wr * 40h)
 26   0040 ~              out (99h),a
 27   0040                      endm
 28   0040                      macro REPORT
 29   0040 ~                    ld a,e
 29   0040 ~              out (2Fh),a
 29   0040 ~              ld a,d
 29   0040 ~              out (2Fh),a
 30   0040                      endm
 31   0040
 32   0040                      ; write 1 KB: byte = L xor H xor salt
 33   0040                      macro VWRITE4K salt
 34   0040 ~                    ld hl,0
 35   0040 ~            .w:     ld a,l
 35   0040 ~              xor h
 35   0040 ~              xor salt
 35   0040 ~              out (98h),a
 36   0040 ~                    inc hl
 36   0040 ~              ld a,h
 36   0040 ~              cp 04h
 36   0040 ~              jr nz,.w
 37   0040                      endm
 38   0040                      macro VCHECK4K salt
 39   0040 ~                    ld hl,0
 40   0040 ~            .r:     in a,(98h)
 40   0040 ~              ld b,a
 41   0040 ~                    ld a,l
 41   0040 ~              xor h
 41   0040 ~              xor salt
 41   0040 ~              cp b
 41   0040 ~              jr z,.ok
 42   0040 ~                    inc de
 43   0040 ~            .ok:    inc hl
 43   0040 ~              ld a,h
 43   0040 ~              cp 04h
 43   0040 ~              jr nz,.r
 44   0040                      endm
