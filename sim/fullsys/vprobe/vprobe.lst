200   0327 7A          >  ld a,d
200   0328 D3 2F       >  out (2Fh),a
201   032A
202   032A                      ; 7  ASO 224's first in-game wait: display OFF and IE0 off (R#1 = 02h), R#9 = 00h,
203   032A                      ;    R#19 = 68h, R#0 = 16h (SCREEN 5, IE1 on), then EI and NO polling -- the line
204   032A                      ;    interrupt must arrive as an IM 1 interrupt (0038h).  The handler does what the
205   032A                      ;    game's does: R#15 = 1, read S#1 (FH must be 1), R#15 = 0.
206   032A                      ;    Errors: no interrupt (timeout), or FH = 0 in the handler.
207   032A 3E 07                ld a,7
207   032C D3 2E          out (2Eh),a
208   032E 11 00 00             ld de,0
209   0331                      VREG 1, 02h
209   0331 3E 02       >        ld a,02h
209   0333 D3 99       >  out (99h),a
209   0335 3E 81       >  ld a,80h | 1
209   0337 D3 99       >  out (99h),a
210   0339                      VREG 9, 00h
210   0339 3E 00       >        ld a,00h
210   033B D3 99       >  out (99h),a
210   033D 3E 89       >  ld a,80h | 9
210   033F D3 99       >  out (99h),a
211   0341                      VREG 19, 68h
211   0341 3E 68       >        ld a,68h
211   0343 D3 99       >  out (99h),a
211   0345 3E 93       >  ld a,80h | 19
211   0347 D3 99       >  out (99h),a
212   0349                  IFDEF P7NEG
213   0349 ~                    VREG 0, 06h                     ; negative control: IE1 off -> phase 7 must time out
214   0349                  ELSE
215   0349                      VREG 0, 16h
215   0349 3E 16       >        ld a,16h
215   034B D3 99       >  out (99h),a
215   034D 3E 80       >  ld a,80h | 0
215   034F D3 99       >  out (99h),a
216   0351                  ENDIF
217   0351 0E 07                ld c,7
218   0353 ED 56                im 1
218   0355 FB             ei
219   0356 21 00 00             ld hl,0
220   0359 2B           i7w:    dec hl
220   035A 7C             ld a,h
220   035B B5             or l
220   035C 20 FB          jr nz,i7w
221   035E F3                   di
222   035F 13                   inc de                          ; no line interrupt in ~65536 loops
223   0360 18 17                jr i7done
224   0362              v7:     VREG 15, 1
224   0362 3E 01       >        ld a,1
224   0364 D3 99       >  out (99h),a
224   0366 3E 8F       >  ld a,80h | 15
224   0368 D3 99       >  out (99h),a
225   036A DB 99                in a,(99h)
225   036C E6 01          and 1
225   036E 20 01          jr nz,v7ok
226   0370 13                   inc de                          ; the handler saw FH = 0
227   0371              v7ok:   VREG 15, 0
227   0371 3E 00       >        ld a,0
227   0373 D3 99       >  out (99h),a
227   0375 3E 8F       >  ld a,80h | 15
227   0377 D3 99       >  out (99h),a
228   0379              i7done: VREG 0, 06h
228   0379 3E 06       >        ld a,06h
228   037B D3 99       >  out (99h),a
228   037D 3E 80       >  ld a,80h | 0
228   037F D3 99       >  out (99h),a
229   0381 0E 00                ld c,0
230   0383                      REPORT
