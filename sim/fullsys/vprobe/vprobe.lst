 42   0040 ~              xor salt
 42   0040 ~              cp b
 42   0040 ~              jr z,.ok
 43   0040 ~                    inc de
 44   0040 ~            .ok:    inc hl
 44   0040 ~              ld a,h
 44   0040 ~              cp 04h
 44   0040 ~              jr nz,.r
 45   0040                      endm
