 36   0040 ~              xor salt
 36   0040 ~              out (98h),a
 37   0040 ~                    inc hl
 37   0040 ~              ld a,h
 37   0040 ~              cp 04h
 37   0040 ~              jr nz,.w
 38   0040                      endm
 39   0040                      macro VCHECK4K salt
 40   0040 ~                    ld hl,0
 41   0040 ~            .r:     in a,(98h)
