184   02CC D3 9F          out (9Fh),a           ; EDATA 0,1
185   02CE 3E 48                ld a,48h
185   02D0 D3 9D          out (9Dh),a
185   02D2 3E 01          ld a,1
185   02D4 D3 9F          out (9Fh),a      ; CTRL: RUN, wireframe
186   02D6 21 00 00             ld hl,0
187   02D9 DB 9D        g_w2:   in a,(9Dh)
187   02DB E6 01          and 01h
187   02DD 28 06          jr z,g_d2                    ; RUN busy
188   02DF 2B                   dec hl
188   02E0 7C             ld a,h
