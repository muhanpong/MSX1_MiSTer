10 ' OPL4 octave test
20 ' 861/430/215/108Hz
30 OUT &HC6,5
40 OUT &HC7,3
50 R=2:V=&H15:GOSUB 950
60 A2=&H30:A1=0:A0=0:GOSUB 900
70 GOSUB 700
80 A2=&H28:A1=0:A0=0:GOSUB 900
90 RESTORE 800
100 FOR I=0 TO 11:READ V:OUT &H7F,V:NEXT I
110 R=2:V=&H14:GOSUB 950
120 R=&H50:V=&H01:GOSUB 950
130 R=&H20:V=&H01:GOSUB 950
140 R=&H08:V=&H80:GOSUB 950
150 ' play 4 octaves
160 RESTORE 600
170 FOR K=0 TO 3
180 READ OC
190 PRINT "oct ";OC
200 R=&H38:V=OC:GOSUB 950
210 R=&H68:V=&HA0:GOSUB 950
220 FOR T=0 TO 2500:NEXT T
230 R=&H68:V=&H20:GOSUB 950
240 FOR T=0 TO 400:NEXT T
250 NEXT K
260 PRINT "done"
270 END
600 DATA &H02,&HF2,&HE2,&HD2
700 FOR I=0 TO 31
710 P=I:IF P>15 THEN P=31-P
720 W=P*4096-30720
730 H=INT(W/256):IF H<0 THEN H=H+256
740 OUT &H7F,H:OUT &H7F,(W AND 255)
750 NEXT I:RETURN
800 DATA &HB0,&H00,&H00,&H00,&H00,&HFF
801 DATA &HE0,&H00,&HF0,&H00,&HF4,&H00
900 OUT &H7E,3:OUT &H7F,A2
910 OUT &H7E,4:OUT &H7F,A1
920 OUT &H7E,5:OUT &H7F,A0
930 OUT &H7E,6
940 RETURN
950 OUT &H7E,R:OUT &H7F,V
960 RETURN
