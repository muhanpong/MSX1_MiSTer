10 ' OPL4 16-bit odd/even square test
20 ' even 300000h / odd 300101h - must sound identical
30 OUT &HC6,5
40 OUT &HC7,3
50 R=2:V=&H15:GOSUB 950
60 A2=&H30:A1=0:A0=0:GOSUB 900
70 FOR I=0 TO 15:OUT &H7F,&H40:OUT &H7F,&H40:NEXT I
80 FOR I=0 TO 15:OUT &H7F,&HC0:OUT &H7F,&HC0:NEXT I
90 A2=&H30:A1=1:A0=1:GOSUB 900
100 FOR I=0 TO 15:OUT &H7F,&H40:OUT &H7F,&H40:NEXT I
110 FOR I=0 TO 15:OUT &H7F,&HC0:OUT &H7F,&HC0:NEXT I
120 A2=&H28:A1=0:A0=0:GOSUB 900
130 RESTORE 800
140 FOR I=0 TO 11:READ V:OUT &H7F,V:NEXT I
150 RESTORE 810
160 FOR I=0 TO 11:READ V:OUT &H7F,V:NEXT I
170 R=2:V=&H14:GOSUB 950
180 R=&H50:V=&H01:GOSUB 950
190 R=&H38:V=&H02:GOSUB 950
200 R=&H20:V=&H01:GOSUB 950
210 R=&H08:V=&H80:GOSUB 950
220 PRINT "EVEN tone"
230 R=&H68:V=&HA0:GOSUB 950
240 FOR T=0 TO 3000:NEXT T
250 R=&H68:V=&H20:GOSUB 950
260 FOR T=0 TO 500:NEXT T
270 R=&H08:V=&H81:GOSUB 950
280 PRINT "ODD tone"
290 R=&H68:V=&HA0:GOSUB 950
300 FOR T=0 TO 3000:NEXT T
310 R=&H68:V=&H20:GOSUB 950
320 PRINT "done - identical?"
330 END
800 DATA &HB0,&H00,&H00,&H00,&H00,&HFF
801 DATA &HE0,&H00,&HF0,&H00,&HF4,&H00
810 DATA &HB0,&H01,&H01,&H00,&H00,&HFF
811 DATA &HE0,&H00,&HF0,&H00,&HF4,&H00
900 OUT &H7E,3:OUT &H7F,A2
910 OUT &H7E,4:OUT &H7F,A1
920 OUT &H7E,5:OUT &H7F,A0
930 OUT &H7E,6
940 RETURN
950 OUT &H7E,R:OUT &H7F,V
960 RETURN
