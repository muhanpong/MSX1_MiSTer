10 ' OPL4 SRAM check - run AFTER vgmplay ST02O
20 ' expected: HDR 5D78 5C25 5E23 5823 5ADD 649E / BLK2 26E7
30 OUT &HC6,5: OUT &HC7,3: ' NEW+NEW2 on
40 OUT &H7E,2: PRINT "R2=";HEX$(INP(&H7F))
50 OUT &H7E,2: OUT &H7F,&H11: ' wavetblhdr=4, mem mode on
60 A2=&H20: A1=0: A0=0: GOSUB 900
70 FOR B=0 TO 5
80 S=0: FOR I=0 TO 255: S=S+INP(&H7F): NEXT I
90 PRINT "HDR";B;"=";HEX$(S)
100 NEXT B
110 A2=&H2E: A1=&H9F: A0=&H3C: GOSUB 900
120 S=0: FOR I=0 TO 63: S=S+INP(&H7F): NEXT I
130 PRINT "BLK2=";HEX$(S)
140 OUT &H7E,2: OUT &H7F,&H10: ' mem mode off
150 END
900 OUT &H7E,3: OUT &H7F,A2
910 OUT &H7E,4: OUT &H7F,A1
920 OUT &H7E,5: OUT &H7F,A0
930 OUT &H7E,6: RETURN
