10 ' OPL4 16-bit odd/even triangle test
20 ' even 300000h / odd 300101h - must sound identical
30 OUT &HC6,5
40 OUT &HC7,3
50 R=2:V=&H15:GOSUB 950
60 A2=&H30:A1=0:A0=0:GOSUB 900
70 GOSUB 700
80 A2=&H30:A1=1:A0=1:GOSUB 900
90 GOSUB 700
100 A2=&H28:A1=0:A0=0:GOSUB 900
110 RESTORE 800
120 FOR I=0 TO 11:READ V:OUT &H7F,V:NEXT I
130 RESTORE 810
140 FOR I=0 TO 11:READ V:OUT &H7F,V:NEXT I
150 R=2:V=&H14:GOSUB 950
160 R=&H50:V=&H01:GOSUB 950
170 R=&H38:V=&H02:GOSUB 950
180 R=&H20:V=&H01:GOSUB 950
190 R=&H08:V=&H80:GOSUB 950
200 PRINT "EVEN triangle"
210 R=&H68:V=&HA0:GOSUB 950
220 FOR T=0 TO 4000:NEXT T
230 R=&H68:V=&H20:GOSUB 950
240 FOR T=0 TO 800:NEXT T
250 R=&H08:V=&H81:GOSUB 950
260 PRINT "ODD triangle"
270 R=&H68:V=&HA0:GOSUB 950
280 FOR T=0 TO 4000:NEXT T
290 R=&H68:V=&H20:GOSUB 950
300 PRINT "done - identical?"
310 END
700 ' upload 32 triangle samples
710 FOR I=0 TO 31
720 P=I:IF P>15 THEN P=31-P
730 W=P*4096-30720
740 H=INT(W/256):IF H<0 THEN H=H+256
750 OUT &H7F,H
760 OUT &H7F,(W AND 255)
770 NEXT I
780 RETURN
800 DATA &HB0,&H00,&H00,&H00,&H00,&HFF
801 DATA &HE0,&H00,&HF0,&H00,&HF4,&H00
810 DATA &HB0,&H01,&H01,&H00,&H00,&HFF
811 DATA &HE0,&H00,&HF0,&H00,&HF4,&H00
900 OUT &H7E,3:OUT &H7F,A2
910 OUT &H7E,4:OUT &H7F,A1
920 OUT &H7E,5:OUT &H7F,A0
930 OUT &H7E,6
940 RETURN
950 OUT &H7E,R:OUT &H7F,V
960 RETURN
