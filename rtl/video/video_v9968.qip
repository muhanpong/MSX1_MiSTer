# The V9968 build (MSX_V9968): the V9968 (upstream, unmodified) for every machine type
# (no TMS9918), and its glue.  The ESE VDP (V9958) is not in this build: its VHDL
# entity is also called vdp.
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) v9968_link.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) v9968_bus.sv ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_color_palette_ram.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_color_palette.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_command_cache.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_command.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_cpu_interface.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_sprite_divide_table.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_sprite_info_collect.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_sprite_makeup_pixel.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_sprite_select_visible_planes.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_timing_control_screen_mode.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_timing_control_sprite.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_timing_control_ssg.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_timing_control.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_upscan_line_buffer.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_upscan.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_video_double_buffer.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_video_out_bilinear.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_video_out.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_video_ram_line_buffer.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) v9968/vdp_vram_interface.v ]
