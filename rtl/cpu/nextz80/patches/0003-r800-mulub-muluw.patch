    reg   [3:0]REG_WSEL;
    reg   [3:0]REG_RSEL;
    reg   [11:0]status;        // 0=AF-AF', 1=HL-HL', 2=DE-HL, 3=DE'-HL', 4=HL-X, 5=IX-IY, 7:6=IFFVAL, 9:8=imode, 10=setIMODE, 11=set IFFVAL
