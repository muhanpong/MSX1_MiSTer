<?xml version="1.0" ?>
<!--
  Panasonic FS-A1mk2 (1987, Japanese MSX2).  No disk drive, no kanji.

  Slot layout follows openMSX share/machines/Panasonic_FS-A1MK2.xml.
  RAM: 64KB (stock).

  no_desk build: the A1 Cockpit ROM(s) are left out entirely, so the machine
  always comes up in MSX-BASIC.  Everything else is identical to the
  'basic' pack.  This is the same idea as Daewoo CPC-300_no_tutor.

  <pattern>4</pattern> is the closest the core can get to the 00/FF byte
  alternation openMSX records; the core also inverts every 256 bytes.

  BIOS and SUB ROM are byte identical across FS-A1, FS-A1mk2 and FS-A1F
  (SHA1 0081ea0d / 0fbd45ef); the packs differ only in firmware, kanji
  and disk.
-->
<msxConfig>
  <type>MSX2</type>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" id="MSX BIOS with BASIC ROM">
        <type>ROM</type>
        <block_count>2</block_count>
        <filename>fs-a1mk2_basic-bios2.rom</filename>
        <SHA1>0081ea0d25bc5cd8d70b60ad8cfdc7307812c0fd</SHA1>
      </block>
    </secondary>
  </primary>
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <type>SLOT A</type>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <type>SLOT B</type>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0" id="Main RAM">
        <type>RAM MAPPER</type>
        <block_count>4</block_count>
        <pattern>4</pattern>
      </block>
    </secondary>
    <secondary slot="1">
      <block start="0" id="MSX Sub ROM">
        <type>ROM</type>
        <block_count>1</block_count>
        <filename>fs-a1mk2_msx2sub.rom</filename>
        <SHA1>0fbd45ef3dd7bb82d4c31f1947884f411f1ca344</SHA1>
      </block>
    </secondary>
  </primary>
</msxConfig>
