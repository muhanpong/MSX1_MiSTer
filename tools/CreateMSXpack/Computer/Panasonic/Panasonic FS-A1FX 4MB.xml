<?xml version="1.0" ?>
<!--
  Panasonic FS-A1FX (1988, Japanese MSX2+) with a 4MB memory mapper.
  Stock is 64 KB; this variant only changes the 3-0 mapper size
  (block_count is in 16 KB units: 4=64KB, 64=1MB, 128=2MB, 256=4MB).

  Slot layout follows openMSX share/machines/Panasonic_FS-A1FX.xml.  The BIOS,
  sub ROM and kanji BASIC are byte identical to the FS-A1WX dumps (same SHA1s).

  Three deliberate differences from the real machine, all requested:

  1. MSX-MUSIC in slot 0-2.  The real FS-A1FX has NO MSX-MUSIC ("No MSX-MUSIC"
     in openMSX's own description); the FM BASIC ROM here is the FS-A1WX one.
     Slot 0 is expanded to make room, exactly as the FS-A1WX pack does.

  2. The floppy controller.  The real machine has a TC8566AF (uPD765 family) and
     this core models only a WD2793, so the original fs-a1fx_disk.rom hangs
     before DOS1.  Slot 3-2 carries the WD2793 disk ROM instead, SHA1 12f2cc79,
     the same substitution the FS-A1WX pack uses.  See the FS-A1WX header.

  3. The A1 Cockpit built-in software IS included (slot 3-3, a plain 32K ROM at
     4000H-BFFFH, no mapper).  It does NOT take over at boot, and that needs no
     patching: entry is gated by the front panel FIRMWARE SWITCH, which software
     reads as bit7 of I/O port 41H.  dev_matsushita reports bit7 = 1 (switch
     OFF), so the machine boots to BASIC and the Cockpit simply sits there.
     Verified on the reference model: openMSX firmwareswitch=false boots to
     BASIC, firmwareswitch=true boots into the Cockpit menu.
     (A future OSD toggle for that switch would drive bit7 here.  Recorded as a
     relationship, not as scheduled work.)

  The turbo itself is real on this machine: FS-A1FX is one of the only three
  models that have it (with FS-A1WX and FS-A1WSX), so <device typ="MATSUSHITA">
  is correct here.  Measured identical to the FS-A1WX: OUT 40H,8 then
  INP(40H);INP(41H) = 247 251, turbo on = 250, off = 251.

  MoonSound is this core's extension rather than FS-A1FX hardware; it is
  declared here for parity with the other packs.
-->
<msxConfig>
  <type>MSX2</type>
  <kbd_layout></kbd_layout>
  <device typ="KANJI" id="Kanji ROM">
    <rom>
      <!-- lowercase <sha1> for device/rom; block/SHA1 is uppercase.  Mixing them
           up is fail-quiet: the ROM is silently dropped from the pack. -->
      <filename>fs-a1fx_kanjifont.rom</filename>
      <sha1>e0e99cd91e88ce2676445663f832c835d74d6fd4</sha1>
    </rom>
  </device>
  <device typ="RESET_STATUS" id="Reset Status register"></device>
  <device typ="MATSUSHITA" id="Matsushita switched I/O (5.37MHz turbo)"></device>
  <device typ="MOONSOUND" id="MoonSound PCM Wave ROM"></device>
  <primary slot="0">
    <secondary slot="0">
      <block start="0" id="MSX BIOS with BASIC ROM">
        <type>ROM</type>
        <block_count>2</block_count>
        <filename>fs-a1fx_basic-bios2p.rom</filename>
        <SHA1>e90f80a61d94c617850c415e12ad70ac41e66bb7</SHA1>
      </block>
    </secondary>
    <secondary slot="2">
      <block start="1" id="MSX Music">
        <type>MSX-MUSIC</type>
        <block_count>1</block_count>
        <filename>fs-a1wx_fmbasic.rom</filename>
        <SHA1>aad42ba4289b33d8eed225d42cea930b7fc5c228</SHA1>
      </block>
    </secondary>
  </primary>
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <type>SLOT A</type>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <type>SLOT B</type>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0" id="Main RAM">
        <type>RAM MAPPER</type>
        <block_count>256</block_count>
        <pattern>4</pattern>
      </block>
    </secondary>
    <secondary slot="1">
      <block start="0" id="MSX Sub ROM">
        <type>ROM</type>
        <block_count>1</block_count>
        <filename>fs-a1fx_msx2psub.rom</filename>
        <SHA1>fe0254cbfc11405b79e7c86c7769bd6322b04995</SHA1>
      </block>
      <block start="1" id="MSX Kanji Driver with BASIC">
        <type>ROM</type>
        <block_count>2</block_count>
        <filename>fs-a1fx_kanjibasic.rom</filename>
        <SHA1>1ef3956f7f918873fb9b031339bba45d1e5e5878</SHA1>
      </block>
    </secondary>
    <secondary slot="2">
      <block start="1" id="Memory Mapped FDC (WD2793 substitute)">
        <type>FDC</type>
        <block_count>1</block_count>
        <filename>hb-f1xd_disk.rom</filename>
        <SHA1>12f2cc79b3d09723840bae774be48c0d721ec1c6</SHA1>
      </block>
    </secondary>
    <secondary slot="3">
      <block start="1" id="A1 Cockpit">
        <type>ROM</type>
        <block_count>2</block_count>
        <filename>fs-a1fx_cockpit.rom</filename>
        <SHA1>9d67fab55b85f4ac4f5924323a70020eb8589057</SHA1>
      </block>
    </secondary>
  </primary>
</msxConfig>
