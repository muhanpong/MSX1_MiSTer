<?xml version="1.0" ?>
<!--
  Sony HB-F1XDmk2 with an expanded memory mapper (1MB).

  Identical to Sony_HB-F1XDmk2.xml except the RAM MAPPER block_count in slot
  3-3: 64 x 16K.  Same sizes the HB-F1XV variants use.  No <pattern> here,
  matching the stock pack, so the power-on RAM fill is left as it was.

  MSX-DOS 2 kernel added in the free 3-1 sub-slot; the driver comes from the
  disk ROM in 3-0.  Same block the A1 packs use (ascii_msxdos22.rom).
-->
<msxConfig>
  <type>MSX2</type>
  <kbd_layout></kbd_layout>
  <primary slot="0">
    <secondary slot="0">
      <block start="0">
        <type>ROM</type>
        <block_count>2</block_count>
        <filename>hb-f1xdmk2_basic-bios2.rom</filename>
        <SHA1>4ce41fcc1a603411ec4e99556409c442078f0ecf</SHA1>
      </block>
    </secondary>
  </primary>
  <primary slot="1">
    <secondary slot="0">
      <block start="0">
        <type>SLOT A</type>
      </block>
    </secondary>
  </primary>
  <primary slot="2">
    <secondary slot="0">
      <block start="0">
        <type>SLOT B</type>
      </block>
    </secondary>
  </primary>
  <primary slot="3">
    <secondary slot="0">
      <block start="0">
        <type>ROM</type>
        <block_count>1</block_count>
        <filename>hb-f1xdmk2_msx2sub.rom</filename>
        <SHA1>0fbd45ef3dd7bb82d4c31f1947884f411f1ca344</SHA1>
      </block>
      <block start="1">
        <type>FDC</type>
        <block_count>1</block_count>
        <filename>hb-f1xdmk2_disk.rom</filename>
        <SHA1>12f2cc79b3d09723840bae774be48c0d721ec1c6</SHA1>
      </block>
    </secondary>
    <secondary slot="1">
      <!-- MSX-DOS 2.  Kernel only: the driver comes from the disk ROM in 3-0,
           which is why this block is only in packs that carry an FDC.  DOS 2
           also needs two free memory-mapper pages, so 64 kB stock packs cannot
           have it; these are all 1 MB or larger.
           3-1 is free on this machine, so nothing is displaced (unlike the
           FS-A1FX pack, where the A1 Cockpit gives up 3-3). -->
      <block start="1" id="MSX-DOS2 ROM">
        <type>MSXDOS2</type>
        <block_count>4</block_count>
        <filename>ascii_msxdos22.rom</filename>
        <SHA1>42f4e3360eb134857b0efa82c1abedf342680124</SHA1>
      </block>
    </secondary>
    <secondary slot="3">
      <block start="0">
        <type>RAM MAPPER</type>
        <block_count>64</block_count>
      </block>
    </secondary>
  </primary>
</msxConfig>
