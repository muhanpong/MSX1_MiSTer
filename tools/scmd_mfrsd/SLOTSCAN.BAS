10 ' SLOT SCANNER  --  find the MFRSD
20 ' prints first 4 bytes at &H4000 of every slot/subslot
30 CLEAR 200,&HCFFF
40 FOR I=0 TO 13: READ A: POKE &HD000+I,A: NEXT
50 DATA 243,62,0,33,0,64,205,12,0,50,16,208,251,201
60 DEFUSR=&HD000
70 FOR P=0 TO 3
80  EX=PEEK(&HFCC1+P) AND 128
90  IF EX=0 THEN N=0 ELSE N=3
100 FOR S=0 TO N
110  IF EX=0 THEN SL=P ELSE SL=128+S*4+P
120  A$=""
130  FOR K=0 TO 3
140   POKE &HD002,SL: POKE &HD004,K
150   A=USR(0): V=PEEK(&HD010)
160   A$=A$+RIGHT$("0"+HEX$(V),2)
170  NEXT
180  IF A$<>"FFFFFFFF" THEN PRINT P;"-";S;" ID=";SL;" ";A$
190 NEXT
200 NEXT
210 PRINT "4142 = AB header = a cartridge"
